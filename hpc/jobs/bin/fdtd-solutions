#!/bin/bash
# Wrapper for fdtd-solutions: hardcode library paths because libinterop-api
# uses Qt QProcess with a custom environment, which may not carry
# FDTD_LD_LIBRARY_PATH from the parent shell on all compute nodes.
export FDTD_LD_LIBRARY_PATH=/usr/local/lumerical-2021R2.5/lib
export LUMERICAL_LD_LIBRARY_PATH=/usr/local/lumerical-2021R2.5/lib
export LUMERICAL_QT_PLUGIN_PATH=/usr/local/lumerical-2021R2.5/bin
export LD_PRELOAD="${HOME}/ompt_stub_v.so${LD_PRELOAD:+:${LD_PRELOAD}}"
exec /usr/local/lumerical-2021R2.5/bin/fdtd-solutions "$@"
