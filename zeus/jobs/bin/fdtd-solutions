#!/bin/bash
# Wrapper for fdtd-solutions: hardcode all paths and license env because
# libinterop-api uses Qt QProcess with a custom environment that strips the
# parent shell's env vars. Everything Lumerical needs must be re-exported here.
_LUM=/usr/local/lumerical-2021R2.5

# Library paths — MKL and Lumerical libs both live in _LUM/lib
export LD_LIBRARY_PATH="${_LUM}/lib${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"
export FDTD_LD_LIBRARY_PATH="${_LUM}/lib"
export LUMERICAL_LD_LIBRARY_PATH="${_LUM}/lib"
export LUMERICAL_QT_PLUGIN_PATH="${_LUM}/bin"

# License — force network server (Technion FlexLM); overrides any user License.ini
export ANSYSLMD_LICENSE_FILE="1055@132.68.48.51"
export ANSYSLI_SERVERS="2325@132.68.48.51"

export LD_PRELOAD="${HOME}/ompt_stub_v.so${LD_PRELOAD:+:${LD_PRELOAD}}"
exec "${_LUM}/bin/fdtd-solutions" "$@"
