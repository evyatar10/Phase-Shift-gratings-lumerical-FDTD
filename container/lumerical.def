# Apptainer recipe for Lumerical 2026 R1.3 on CUDA 12 (Ubuntu 22.04).
#
# ⚠ NOT THE ROUTINE UPGRADE PATH. This is the canonical from-scratch build, kept
# for the day the live image must be recreated. To put a NEW Lumerical version
# into the existing image, use the `update-container` skill instead — on-Athena
# sandbox surgery, ~1 h, and the 5 GB .sif never crosses the VPN. This recipe
# ends in a 5.5 GB upload over that link.
#
# APPROACH: copies the already-installed Lumerical directory from the WSL2
# build host directly into the container — no installer download or browser
# auth required at build time.
#
# R1.3 source tree = the LINX64 package the user downloads from the Ansys portal:
# one ~1.1 GB RPM at <pkg>/rpm_install_files/Lumerical-2026R1-3-*.el8.x86_64.rpm.
# Extract it (`rpm2cpio <rpm> | cpio -idm`, needs rpm2cpio — present on Rocky/RHEL,
# NOT on Ubuntu/WSL by default: `sudo apt install rpm2cpio cpio`) and stage the
# resulting opt/lumerical/v261 at ~/ansys_incS_R13/v261/Lumerical (2026-08-12).
# The tree keeps licensingclient INSIDE v261 — the %files line below points there.
#
# Build (from WSL2, after the R1.3 tree is staged at ~/ansys_incS_R13/v261/Lumerical):
#   cd container
#   apptainer build lumerical-2026R1.sif lumerical.def
#
# Convert to Enroot .sqsh for Athena's Pyxis (run on Athena login node):
#   enroot import --output lumerical-2026R1.sqsh apptainer://$(pwd)/lumerical-2026R1.sif
#
# License defaults baked into %environment (11055@dgx-master / 12325@172.25.0.12).
# Override at runtime if the server address changes:
#   apptainer exec --env ANSYSLMD_LICENSE_FILE=11055@dgx-master ...

Bootstrap: docker
From: nvcr.io/nvidia/cuda:12.2.2-devel-ubuntu22.04
# Athena DGX nodes ship NVIDIA driver R470 LTS (native cap CUDA 11.4).
# CUDA 12.2 is the smallest forward-compat bridge over R470 — see %environment
# for the LD_LIBRARY_PATH ordering that activates the cuda-compat-12-2 shim.

%files
    # Copy the already-installed Lumerical directory from the WSL2 host.
    # Destination is /opt/lumerical_src (NOT /tmp — tmpfs is too small for 3.7 GB).
    # Moved to final location in %post.
    /home/evyatar10/ansys_incS_R13/v261/Lumerical /opt/lumerical_src
    # ANSYS License Client — required for license checkout (ansyscl).
    # Engine binary has /ansys_inc/v261/licensingclient hardcoded as lookup path.
    /home/evyatar10/ansys_incS_R13/v261/Lumerical/licensingclient /opt/licensingclient_src

%post
    set -e
    export DEBIAN_FRONTEND=noninteractive

    # ── OS dependencies ───────────────────────────────────────────────────────
    apt-get update -qq && apt-get install -y --no-install-recommends \
        libx11-6 \
        libx11-xcb1 \
        libxcb1 \
        libxcb-dri2-0 \
        libxcb-dri3-0 \
        libxcb-glx0 \
        libxcb-present0 \
        libxcb-shm0 \
        libxcb-xfixes0 \
        libxcb-shape0 \
        libxcb-sync1 \
        libxcb-randr0 \
        libxcb-render0 \
        libxcb-render-util0 \
        libxcb-icccm4 \
        libxcb-image0 \
        libxcb-keysyms1 \
        libxcb-util1 \
        libxcb-xinerama0 \
        libxcb-xkb1 \
        libxkbcommon0 \
        libxkbcommon-x11-0 \
        libxrender1 \
        libxrandr2 \
        libxss1 \
        libxt6 \
        libxtst6 \
        libxi6 \
        libglu1-mesa \
        libgl1-mesa-glx \
        libgl1-mesa-dri \
        libopengl0 \
        freeglut3 \
        libfontconfig1 \
        libfreetype6 \
        libasound2 \
        libnss3 \
        libnss3-tools \
        libxslt1.1 \
        libltdl7 \
        libopenmpi3 \
        xvfb \
        x11-xserver-utils \
        openssh-client \
        libstdc++6 \
        libc6 \
        libgomp1 \
        libgcc-s1 \
        ca-certificates \
        procps \
    && rm -rf /var/lib/apt/lists/*

    # ── Move Lumerical files to final location ────────────────────────────────
    mkdir -p /opt/lumerical
    mv /opt/lumerical_src /opt/lumerical/v261

    # ── Permissions ───────────────────────────────────────────────────────────
    chmod -R a+rX /opt/lumerical/v261
    chmod +x /opt/lumerical/v261/bin/fdtd-engine-ompi-lcl
    chmod +x /opt/lumerical/v261/bin/fdtd-engine-impi-lcl
    chmod +x /opt/lumerical/v261/bin/fdtd-solutions
    chmod +x /opt/lumerical/v261/bin/fdtd-solutions-app
    chmod +x /opt/lumerical/v261/bin/fdtd-solutions-batch

    # ── Install ANSYS License Client at the hardcoded path the engine expects ────
    # fdtd-engine-ompi-lcl looks for /ansys_inc/v261/licensingclient/linx64/ansyscl
    mkdir -p /ansys_inc/v261
    mv /opt/licensingclient_src /ansys_inc/v261/licensingclient
    chmod -R a+rX /ansys_inc/v261/licensingclient
    chmod +x /ansys_inc/v261/licensingclient/linx64/ansyscl \
             /ansys_inc/v261/licensingclient/linx64/lmutil \
             /ansys_inc/v261/licensingclient/linx64/ansysli_util 2>/dev/null || true

    # ── Verify engine binary is present ──────────────────────────────────────
    if [[ ! -x /opt/lumerical/v261/bin/fdtd-engine-ompi-lcl ]]; then
        echo "ERROR: fdtd-engine-ompi-lcl not found at /opt/lumerical/v261/bin/"
        exit 1
    fi
    if [[ ! -f /ansys_inc/v261/licensingclient/linx64/ansyscl ]]; then
        echo "ERROR: ansyscl not found at /ansys_inc/v261/licensingclient/linx64/ansyscl"
        exit 1
    fi
    if [[ ! -f /ansys_inc/v261/licensingclient/linx64/lmutil ]]; then
        echo "ERROR: lmutil not found at /ansys_inc/v261/licensingclient/linx64/lmutil"
        exit 1
    fi

%environment
    export LUMERICAL_HOME=/opt/lumerical/v261
    export ANSYS_LIC_CLIENT=/ansys_inc/v261/licensingclient/linx64
    export PATH="${LUMERICAL_HOME}/bin:${ANSYS_LIC_CLIENT}:${PATH}"
    # /usr/local/cuda/compat MUST come first: it holds the cuda-compat-12-2
    # userspace shim that lets the CUDA 12 runtime work over Athena's R470 host
    # driver (which natively only supports CUDA 11.4). Without this prefix,
    # apptainer --nv injects the host's R470 libcuda.so.1 first and the GPU
    # FDTD engine fails to initialize (or silently CPU-falls-back).
    export LD_LIBRARY_PATH="/usr/local/cuda/compat:${LUMERICAL_HOME}/lib:${LUMERICAL_HOME}/lib/mesa:${LD_LIBRARY_PATH}"
    export LUMAPI_PYTHON="${LUMERICAL_HOME}/api/python"
    export ANSYSLMD_LICENSE_FILE=11055@dgx-master
    export ANSYSLI_SERVERS=12325@172.25.0.12
    export QT_QPA_PLATFORM=offscreen
    export QT_OPENGL=software

%runscript
    exec "$@"

%labels
    Maintainer evyatar10.rubin@gmail.com
    Lumerical 2026-R1.3
    BaseImage nvcr.io/nvidia/cuda:12.2.2-devel-ubuntu22.04
    CUDA 12.2 (forward-compat over R470 host driver via /usr/local/cuda/compat)
    GPU A100-compatible (compute capability >=5.0)

%help
    Lumerical 2026 R1.3 with CUDA 12 support for Technion Athena (DGX A100).
    Built by copying a pre-installed Lumerical tree from the WSL2 host.

    Engine-only run (Option 1):
      apptainer exec --nv \
           --bind <fsp_dir>:/work/layouts --bind ~/hosts_lum:/etc/hosts \
           lumerical-2026R1.sif \
           fdtd-engine-ompi-lcl -t 16 -logall -use-gpu-resources my_sim.fsp

    Full Python / lumapi run (Option 2):
      apptainer exec --nv \
           --bind <project_dir>:/work/project --bind ~/hosts_lum:/etc/hosts \
           lumerical-2026R1.sif \
           xvfb-run -a python /work/scripts/athena_run.py
