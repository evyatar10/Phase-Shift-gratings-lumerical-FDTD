# Apptainer recipe for Lumerical 2026 R1.1 on CUDA 12 (Ubuntu 22.04).
#
# APPROACH: copies the already-installed Lumerical directory from the WSL2
# build host directly into the container — no installer download or browser
# auth required at build time.
#
# Build (from WSL2, after Lumerical is installed at ~/ansys_incS/v261/Lumerical):
#   cd hpc_gpu/container
#   apptainer build lumerical-2026R1.sif lumerical.def
#
# Convert to Enroot .sqsh for Athena's Pyxis (run on Athena login node):
#   enroot import --output lumerical-2026R1.sqsh apptainer://$(pwd)/lumerical-2026R1.sif
#
# License is NOT baked in — pass at runtime via --container-env:
#   --container-env=ANSYSLMD_LICENSE_FILE=1055@132.68.48.51

Bootstrap: docker
From: nvcr.io/nvidia/cuda:12.4.1-devel-ubuntu22.04

%files
    # Copy the already-installed Lumerical directory from the WSL2 host.
    # Destination is /opt/lumerical_src (NOT /tmp — tmpfs is too small for 3.7 GB).
    # Moved to final location in %post.
    /home/evyatar10/ansys_incS/v261/Lumerical /opt/lumerical_src

%post
    set -e
    export DEBIAN_FRONTEND=noninteractive

    # ── OS dependencies ───────────────────────────────────────────────────────
    apt-get update -qq && apt-get install -y --no-install-recommends \
        libx11-6 \
        libx11-xcb1 \
        libxcb1 \
        libxcb-dri2-0 \
        libxcb-dri3-0 \
        libxcb-glx0 \
        libxcb-present0 \
        libxcb-shm0 \
        libxcb-xfixes0 \
        libxcb-shape0 \
        libxcb-sync1 \
        libxcb-randr0 \
        libxcb-render0 \
        libxcb-render-util0 \
        libxcb-icccm4 \
        libxcb-image0 \
        libxcb-keysyms1 \
        libxcb-util1 \
        libxcb-xinerama0 \
        libxcb-xkb1 \
        libxkbcommon0 \
        libxkbcommon-x11-0 \
        libxrender1 \
        libxrandr2 \
        libxss1 \
        libxt6 \
        libxtst6 \
        libxi6 \
        libglu1-mesa \
        libgl1-mesa-glx \
        libgl1-mesa-dri \
        libopengl0 \
        freeglut3 \
        libfontconfig1 \
        libfreetype6 \
        libasound2 \
        libnss3 \
        libnss3-tools \
        libxslt1.1 \
        libltdl7 \
        libopenmpi3 \
        xvfb \
        x11-xserver-utils \
        openssh-client \
        libstdc++6 \
        libc6 \
        libgomp1 \
        libgcc-s1 \
        ca-certificates \
        procps \
    && rm -rf /var/lib/apt/lists/*

    # ── Move Lumerical files to final location ────────────────────────────────
    mkdir -p /opt/lumerical
    mv /opt/lumerical_src /opt/lumerical/v261

    # ── Permissions ───────────────────────────────────────────────────────────
    chmod -R a+rX /opt/lumerical/v261
    chmod +x /opt/lumerical/v261/bin/fdtd-engine-ompi-lcl
    chmod +x /opt/lumerical/v261/bin/fdtd-engine-impi-lcl
    chmod +x /opt/lumerical/v261/bin/fdtd-solutions
    chmod +x /opt/lumerical/v261/bin/fdtd-solutions-app
    chmod +x /opt/lumerical/v261/bin/fdtd-solutions-batch

    # ── Verify engine binary is present ──────────────────────────────────────
    if [[ ! -x /opt/lumerical/v261/bin/fdtd-engine-ompi-lcl ]]; then
        echo "ERROR: fdtd-engine-ompi-lcl not found at /opt/lumerical/v261/bin/"
        exit 1
    fi

%environment
    export LUMERICAL_HOME=/opt/lumerical/v261
    export PATH="${LUMERICAL_HOME}/bin:${PATH}"
    export LD_LIBRARY_PATH="${LUMERICAL_HOME}/lib:${LUMERICAL_HOME}/lib/mesa:${LD_LIBRARY_PATH}"
    export LUMAPI_PYTHON="${LUMERICAL_HOME}/api/python"
    export ANSYSLMD_LICENSE_FILE=1055@132.68.48.51
    export QT_QPA_PLATFORM=offscreen
    export QT_OPENGL=software

%runscript
    exec "$@"

%labels
    Maintainer evyatar10.rubin@gmail.com
    Lumerical 2026-R1.1
    BaseImage nvcr.io/nvidia/cuda:12.4.1-devel-ubuntu22.04
    CUDA 12.4
    GPU A100-compatible (compute capability >=5.0)

%help
    Lumerical 2026 R1.1 with CUDA 12 support for Technion Athena (DGX A100).
    Built by copying a pre-installed Lumerical tree from the WSL2 host.

    Engine-only run (Option 1):
      srun --container-image=lumerical-2026R1.sqsh \
           --container-env=ANSYSLMD_LICENSE_FILE=1055@132.68.48.51 \
           fdtd-engine-ompi-lcl -t 16 -logall -use-gpu-resources my_sim.fsp

    Full Python / lumapi run (Option 2):
      srun --container-image=lumerical-2026R1.sqsh \
           --container-env=ANSYSLMD_LICENSE_FILE=1055@132.68.48.51 \
           xvfb-run -a python /work/hpc_gpu/scripts/athena_run.py
